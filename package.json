{
  "name": "bun-payments-api",
  "version": "1.0.0",
  "description": "RESTful API for monthly service payment management",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "db:push": "drizzle-kit push:sqlite",
    "db:studio": "drizzle-kit studio",
    "type-check": "tsc --noEmit",
    "test": "bun test --coverage tests/",
    "test:watch": "bun test --watch tests/",
    "test:unit": "bun test tests/unit/",
    "test:integration": "bun test tests/integration/",
    "test:e2e": "bun test tests/e2e/",
    "test:coverage": "bun test --coverage tests/ --coverage-reporter=text,lcov",
    "test:all": "bun test tests/ --coverage && bun run type-check",
    "lint": "bunx biome lint src/",
    "format": "bunx biome format --write src/ tests/",
    "format:check": "bunx biome format --check src/ tests/",
    "prepare": "husky install"
  },
  "keywords": [
    "payments",
    "bun",
    "hono",
    "api"
  ],
  "author": "Josue",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.20.0",
    "husky": "^9.0.0",
    "@commitlint/cli": "^18.0.0",
    "@commitlint/config-conventional": "^18.0.0"
  }
}
